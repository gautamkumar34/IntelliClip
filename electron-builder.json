{
    "appId": "com.Dev-help.Intelligent-Clipboard",
    "files": ["dist-electron","dist-react"],
    "icon":"./desktopIcon.png",
    "mac":{
        "target":"dmg"
    },
    "linux":{
        "target":"AppImage",
        "category":"Utility"
    },
    "win":{
        "target":["portable","msi"]
    },
    "extraResources": [
        {
            "from": "resources/models",
            "to": "models",
            "filter": ["*.gguf"]
        }
    ],
    "asarUnpack": [
        "node_modules/node-llama-cpp/**"
    ]
}